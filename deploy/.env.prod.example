# Production env template — copy to deploy/.env.prod on the VPS
# Never commit real secrets. See deploy/VM-DEPLOY.md and deploy/HYBRID-PROVIDERS.md

API_HOST=api.poreiago.com
APP_HOST=www.poreiago.com
ACME_EMAIL=ops@example.com
PUBLIC_APP_URL=https://www.poreiago.com
FRONTEND_PUBLIC_URL=https://www.poreiago.com
DRIVER_APP_PUBLIC_URL=https://www.poreiago.com
# VPS public IP — used to decide when apex custom domains (e.g. achilliotravel.com)
# can receive a Let's Encrypt cert (must match the DNS A record).
PLATFORM_INGRESS_IP=34.141.98.145

POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aerostride
DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@postgres:5432/aerostride

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

AUTH_JWT_SECRET=change-me-min-32-chars-auth
TICKET_JWT_SECRET=change-me-min-32-chars-ticket

BILLING_DEMO_MODE=true

# --- Web Push (My Wallet MARK notifications) ---
# Auto-generated on API boot into /app/data when missing.
# Or run: python3 deploy/scripts/generate_vapid_keys.py
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/app/data/vapid_private.pem
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com

# --- Fiscal MARK / myDATA ---
# Prosvasis / Epsilon secrets are entered per-office in Admin → Φορολογία
# (encrypted with FISCAL_ENCRYPTION_KEY). Native AADE uses env vars below.
#
# AADE_MODE=stub only affects the legacy native gateway demo path.
# Leave stub until native AADE credentials are real; Prosvasis/Epsilon still work.
AADE_MODE=stub
AADE_USER_ID=
AADE_SUBSCRIPTION_KEY=
AADE_VAT_NUMBER=
AADE_API_URL=
AADE_SECRETS_BACKEND=env
# Auto-generated by deploy/scripts/ensure-env-prod.sh when missing:
FISCAL_ENCRYPTION_KEY=
# Optional pipeline knobs (defaults are fine):
# FISCAL_STUCK_MINUTES=45
# FISCAL_AUTO_RETRY_MAX=3
# See docs/FISCAL-PROVIDER-SETUP.md

# Hybrid — Aviationstack + Twilio (live when filled)
AVIATIONSTACK_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# --- My Wallet Google Sign-In ---
# OAuth 2.0 Web Client ID from Google Cloud Console (not a secret — used in browser).
# Guide: deploy/GOOGLE-SIGNIN.md
# Authorized JavaScript origins must include every office host, e.g.:
#   https://www.poreiago.com
#   https://www.achilliotravel.com
#   http://localhost:5173
GOOGLE_CLIENT_ID=
# Optional build-time mirror (vm-deploy-all.sh copies from GOOGLE_CLIENT_ID when set)
VITE_GOOGLE_CLIENT_ID=
