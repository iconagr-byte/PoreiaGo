{
  "name": "poreiago",
  "private": true,
  "version": "0.0.0",
  "description": "PoreiaGo — travel operations platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && python -m uvicorn wallet_main:app --host 127.0.0.1 --port 8001",
    "test:customer-flows": "cd backend && python -m unittest tests.test_customer_payments_qr -v",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "node scripts/cap-wallet-sync.mjs --packaged",
    "cap:sync:live": "node scripts/cap-wallet-sync.mjs --live https://www.achilliotravel.com",
    "cap:sync:packaged": "node scripts/cap-wallet-sync.mjs --packaged",
    "cap:open": "npx cap open android",
    "cap:android": "npm run cap:sync:packaged && npx cap open android",
    "cap:android:packaged": "npm run cap:sync:packaged && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.5.18",
    "@react-oauth/google": "^0.13.5",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "mapbox-gl": "^3.25.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.1",
    "react-qr-code": "^2.0.21",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "react-router-dom": "^7.16.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.12"
  }
}
